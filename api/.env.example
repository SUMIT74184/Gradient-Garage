ENV=development
DATABASE_URL=postgresql+psycopg://gg:gg@127.0.0.1:5433/gg
# Shared with the website (web/.env.local). Required in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:3000

# Public URL of the website (links in emails)
APP_URL=http://localhost:3000
SITE_NAME=Gradient Garage

# Outgoing email over SMTP. Leave SMTP_HOST empty in development: emails are written to
# api/outbox/*.eml instead. Examples:
#   Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465 SMTP_SECURITY=ssl SMTP_USER=resend SMTP_PASSWORD=<api key>
#   Postmark: SMTP_HOST=smtp.postmarkapp.com SMTP_PORT=587 SMTP_USER=<server token> SMTP_PASSWORD=<server token>
#   Gmail:    SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Gradient Garage <no-reply@example.com>

# Public sign-up on /signup (team members still join by invite)
ALLOW_SIGNUP=true

# Hugging Face / GitHub sync (admin → Hugging Face sync, or `python -m scripts.sync` from cron).
# Default account(s) to import from until an Owner saves sync settings in the admin panel.
HF_USERNAME=
# Optional: private items and higher rate limits. Server-side only.
HF_TOKEN=
GITHUB_TOKEN=
