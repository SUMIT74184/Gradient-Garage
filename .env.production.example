# Copy to .env.production and fill in. Never commit the real file.
DOMAIN=hub.example.com

# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=

# Email (required for sign-up confirmation and password resets), see api/.env.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Gradient Garage <no-reply@hub.example.com>

# Optional sign-in providers (callbacks: https://DOMAIN/auth/github/callback, /auth/google/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The GitHub link, site name etc. are edited in the admin panel (Site settings).
